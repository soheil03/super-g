<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="ubuntu-plus">
  <schema id="org.gnome.shell.extensions.ubuntu-plus" path="/org/gnome/shell/extensions/ubuntu-plus/">

    <!-- Modules -->
    <key name="module-appearance" type="b">
      <default>true</default>
      <summary>Theme GTK apps and the shell from the palette</summary>
    </key>
    <key name="broken-modules" type="as">
      <default>[]</default>
      <summary>Modules switched off after an error; cleared from prefs</summary>
    </key>

    <!-- Appearance -->
    <key name="palette" type="s">
      <default>'catppuccin'</default>
      <summary>Palette: graphite, catppuccin, stone or slate</summary>
    </key>
    <key name="accent" type="s">
      <default>'auto'</default>
      <summary>Accent name, or auto for the palette default</summary>
    </key>
    <key name="window-buttons" type="s">
      <default>'capsule'</default>
      <summary>Window button style: capsule, mini-dots or close-emphasized</summary>
    </key>
    <key name="window-radius" type="i">
      <range min="0" max="28"/>
      <default>18</default>
      <summary>Window corner radius in pixels</summary>
    </key>
    <key name="sidebar-style" type="s">
      <default>'floating-card'</default>
      <summary>Sidebar style: floating-card or stock</summary>
    </key>
    <key name="title-weight" type="i">
      <range min="400" max="800"/>
      <default>600</default>
      <summary>Window title font weight</summary>
    </key>
    <key name="theme-gtk" type="b">
      <default>true</default>
      <summary>Apply the theme to GTK3 and GTK4 apps</summary>
    </key>
    <key name="theme-shell" type="b">
      <default>true</default>
      <summary>Apply the theme to menus, popups and dialogs of the shell</summary>
    </key>
    <key name="sync-system-accent" type="b">
      <default>true</default>
      <summary>Set GNOME's accent to the closest match, for apps outside the theme</summary>
    </key>

    <!-- Fonts -->
    <key name="manage-fonts" type="b">
      <default>true</default>
      <summary>Apply the fonts below system-wide</summary>
    </key>
    <key name="font-interface" type="s">
      <default>'Ubuntu Sans 11'</default>
      <summary>Interface font</summary>
    </key>
    <key name="font-document" type="s">
      <default>'Ubuntu Sans 11'</default>
      <summary>Document font</summary>
    </key>
    <key name="font-monospace" type="s">
      <default>'Ubuntu Sans Mono 11'</default>
      <summary>Monospace font</summary>
    </key>
    <key name="text-scaling" type="d">
      <range min="0.5" max="3.0"/>
      <default>1.11</default>
      <summary>Text scaling factor</summary>
    </key>

    <!-- Motion -->
    <key name="motion-curve" type="s">
      <default>'snappy'</default>
      <summary>Animation feel: snappy or soft</summary>
    </key>
    <key name="animation-speed" type="d">
      <range min="0.5" max="2.0"/>
      <default>1.15</default>
      <summary>Animation duration multiplier; above 1 is slower</summary>
    </key>
    <key name="reduce-motion" type="b">
      <default>false</default>
      <summary>Replace movement with quick fades</summary>
    </key>
  </schema>
</schemalist>
